# Server-only description provider. Use `ollama` for local development or
# `dashscope` for Alibaba Model Studio. Never prefix these with NEXT_PUBLIC_.
DESCRIPTION_PROVIDER=ollama

# Local Ollama configuration. The route only accepts a loopback endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VL_MODEL=qwen3-vl:2b-instruct

# Alibaba Model Studio configuration, used when DESCRIPTION_PROVIDER=dashscope.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-wixqcfw8kkpu5v6h.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# Public browser client configuration for Member B's Supabase project.
# The anon key is intended for browser use; database/storage RLS must enforce access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
